{
  "$defs": {
    "AcceptedTurn": {
      "additionalProperties": false,
      "properties": {
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        }
      },
      "required": [
        "turn_id",
        "generation_id"
      ],
      "title": "AcceptedTurn",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "request_id"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "BusinessSnapshot": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.4.0",
          "default": "0.4.0",
          "title": "Contract Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "CASE_READY",
            "ROUTING",
            "OPENING",
            "VERIFYING",
            "EXPLAINING",
            "QA",
            "CALLBACK_PENDING",
            "CLOSING",
            "ACTION_READY",
            "EXECUTING",
            "RECONCILING",
            "WRITEBACK_PENDING",
            "CLOSED",
            "MANUAL_REVIEW"
          ],
          "title": "State",
          "type": "string"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "case_revision": {
          "minimum": 1,
          "title": "Case Revision",
          "type": "integer"
        },
        "knowledge_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Knowledge Version",
          "type": "string"
        },
        "generation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        },
        "last_event_seq": {
          "minimum": 0,
          "title": "Last Event Seq",
          "type": "integer"
        },
        "oldest_available_seq": {
          "minimum": 1,
          "title": "Oldest Available Seq",
          "type": "integer"
        },
        "operations": {
          "items": {
            "$ref": "#/$defs/OperationResult"
          },
          "title": "Operations",
          "type": "array"
        },
        "playback": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlaybackProgress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "session_id",
        "state",
        "state_revision",
        "case_revision",
        "knowledge_version",
        "last_event_seq",
        "oldest_available_seq"
      ],
      "title": "BusinessSnapshot",
      "type": "object"
    },
    "BusinessTurnInput": {
      "additionalProperties": false,
      "properties": {
        "input_id": {
          "format": "uuid",
          "title": "Input Id",
          "type": "string"
        },
        "text": {
          "maxLength": 8000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "final": {
          "const": true,
          "default": true,
          "title": "Final",
          "type": "boolean"
        },
        "understanding_candidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/UnderstandingCandidate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "input_id",
        "text"
      ],
      "title": "BusinessTurnInput",
      "type": "object"
    },
    "ContractError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "UNAUTHORIZED",
            "SESSION_NOT_FOUND",
            "BINDING_EXPIRED",
            "CONTRACT_VERSION_UNSUPPORTED",
            "INVALID_INPUT",
            "INPUT_NOT_FINAL",
            "REQUEST_CONFLICT",
            "REVISION_CONFLICT",
            "STALE_GENERATION",
            "CURSOR_EXPIRED",
            "CURSOR_AHEAD",
            "SUBSCRIBER_LIMIT",
            "SLOW_CONSUMER",
            "BUSY",
            "BUSINESS_TIMEOUT",
            "OPERATION_UNKNOWN",
            "SERVICE_UNAVAILABLE",
            "PLAYBACK_EVIDENCE_REJECTED",
            "INTERNAL_ERROR"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "request_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "current_state_revision": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current State Revision"
        },
        "retry_after_ms": {
          "anyOf": [
            {
              "maximum": 60000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After Ms"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ContractError",
      "type": "object"
    },
    "EventSubscription": {
      "additionalProperties": false,
      "properties": {
        "after_seq": {
          "default": 0,
          "minimum": 0,
          "title": "After Seq",
          "type": "integer"
        }
      },
      "title": "EventSubscription",
      "type": "object"
    },
    "GenerationFinished": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "generation.finished",
