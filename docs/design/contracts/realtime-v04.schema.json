    "UnderstandingCandidate": {
      "additionalProperties": false,
      "description": "Untrusted suggestions; grounding and state checks are still required.",
      "properties": {
        "intents": {
          "items": {
            "enum": [
              "confirm_identity",
              "deny_identity",
              "ask_reason",
              "ask_remedy",
              "ask_guarantee",
              "ask_source",
              "ask_outcome",
              "refuse_contact",
              "request_callback",
              "acknowledge",
              "unclear",
              "complaint_risk"
            ],
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Intents",
          "type": "array"
        },
        "slots": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 16,
          "title": "Slots",
          "type": "object"
        },
        "needs_clarification": {
          "default": false,
          "title": "Needs Clarification",
          "type": "boolean"
