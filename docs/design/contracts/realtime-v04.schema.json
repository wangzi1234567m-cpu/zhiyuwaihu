          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "interrupted",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "status",
        "message_id"
      ],
      "title": "GenerationFinished",
      "type": "object"
    },
    "GenerationInterrupt": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "generation_id"
      ],
      "title": "GenerationInterrupt",
      "type": "object"
    },
    "Interrupted": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        }
      },
      "required": [
        "applied"
      ],
      "title": "Interrupted",
      "type": "object"
    },
    "OperationResult": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "reject_application",
                "create_callback",
                "create_followup",
                "writeback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kind"
        },
        "operation_id": {
          "format": "uuid",
          "title": "Operation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "succeeded",
            "failed",
            "unknown",
            "not_found_yet"
          ],
          "title": "Status",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resource Id"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApiError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "status",
        "updated_at"
      ],
      "title": "OperationResult",
      "type": "object"
    },
    "OperationUpdated": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "operation.updated",
          "title": "Type",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/OperationResult"
        }
      },
      "required": [
        "type",
        "result"
      ],
      "title": "OperationUpdated",
      "type": "object"
    },
    "PlaybackProgress": {
      "additionalProperties": false,
      "properties": {
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "verified_segment_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Verified Segment Ids",
          "type": "array"
        },
        "message_fully_notified": {
          "default": false,
          "title": "Message Fully Notified",
          "type": "boolean"
        }
      },
      "required": [
        "generation_id",
        "message_id"
      ],
      "title": "PlaybackProgress",
      "type": "object"
    },
    "PlaybackReport": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "playback_instance_id": {
          "format": "uuid",
          "title": "Playback Instance Id",
          "type": "string"
        },
        "text_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "observation": {
          "enum": [
            "started",
            "completed",
            "interrupted",
            "failed"
          ],
          "title": "Observation",
          "type": "string"
        },
        "clock_domain": {
          "enum": [
            "browser.performance",
            "server.monotonic"
          ],
          "title": "Clock Domain",
          "type": "string"
        },
        "elapsed_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsed Ms"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        }
      },
      "required": [
        "report_id",
        "generation_id",
        "message_id",
        "segment_id",
        "playback_instance_id",
        "text_sha256",
        "observation",
        "clock_domain"
      ],
      "title": "PlaybackReport",
      "type": "object"
    },
    "PlaybackReportResult": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "observation_recorded",
            "evidence_verified",
            "evidence_rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "enum": [
            "OBSERVATION_ONLY",
            "SERVER_PROOF_MATCHED",
            "PROOF_NOT_FOUND",
            "PROOF_BINDING_MISMATCH",
            "INCOMPLETE_PLAYBACK",
            "STALE_GENERATION"
          ],
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "status",
        "reason_code"
      ],
      "title": "PlaybackReportResult",
      "type": "object"
    },
    "RealtimeBusinessEvent": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "0.4.0",
          "default": "0.4.0",
          "title": "Contract Version",
          "type": "string"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "operation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Id"
        },
        "seq": {
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "knowledge_version": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Knowledge Version",
          "type": "string"
        },
        "payload": {
          "discriminator": {
            "mapping": {
              "generation.finished": "#/$defs/GenerationFinished",
              "operation.updated": "#/$defs/OperationUpdated",
              "reply.completed": "#/$defs/ReplyCompleted",
              "reply.segment_ready": "#/$defs/ReplySegmentReady",
              "turn.failed": "#/$defs/TurnFailed",
              "turn.interrupted": "#/$defs/TurnInterrupted",
              "turn.started": "#/$defs/TurnStarted",
              "writeback.completed": "#/$defs/WritebackCompleted"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TurnStarted"
            },
            {
              "$ref": "#/$defs/TurnInterrupted"
            },
            {
              "$ref": "#/$defs/GenerationFinished"
            },
            {
              "$ref": "#/$defs/OperationUpdated"
            },
            {
              "$ref": "#/$defs/ReplySegmentReady"
            },
            {
              "$ref": "#/$defs/ReplyCompleted"
            },
            {
              "$ref": "#/$defs/TurnFailed"
            },
            {
              "$ref": "#/$defs/WritebackCompleted"
            }
          ],
          "title": "Payload"
        }
      },
      "required": [
        "event_id",
        "session_id",
        "turn_id",
        "generation_id",
        "seq",
        "state_revision",
        "occurred_at",
        "knowledge_version",
        "payload"
      ],
      "title": "RealtimeBusinessEvent",
      "type": "object"
    },
    "ReplyCompleted": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "reply.completed",
