# Local development only. Do not publish this environment to the internet.
POSTGRES_PASSWORD=local-dev-only
COOKIE_SECRET=local-development-secret-change-before-exposure
DEMO_PASSWORD=demo-local-only
PUBLIC_ORIGIN=http://localhost:3000
ENABLE_FAULTS=false
# Native backend: set this in the shell before starting. Compose uses db hostname.
DATABASE_URL=postgresql+psycopg://zhiyu:local-dev-only@localhost:5432/zhiyu
APP_ENV=development
BACKEND_URL=http://127.0.0.1:8000
