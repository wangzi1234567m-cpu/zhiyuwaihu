# Local development only. Do not publish this environment to the internet.
# 【项目数据库】本地PostgreSQL密码；不是声网字段。
POSTGRES_PASSWORD=local-dev-only
# 【项目内部密钥】已随机生成，用于登录Cookie签名；不是声网字段，保持原值。
COOKIE_SECRET=local-development-secret-change-before-exposure
# 【项目本地登录】本地页面的演示登录密码；不是声网账号密码。
DEMO_PASSWORD=demo-local-only
# Independent staff credential. Staging requires explicit strong configuration.
STAFF_PASSWORD=staff-local-only
# 【项目页面地址】本地页面地址；公网部署后调整为页面HTTPS域名。
PUBLIC_ORIGIN=http://localhost:3000
# 【项目测试开关】保持false；与声网无关。
ENABLE_FAULTS=false
# Native backend: set this in the shell before starting. Compose uses db hostname.
# 【项目数据库连接】本地/容器PostgreSQL连接；无需到声网填写。
DATABASE_URL=postgresql+psycopg://zhiyu:local-dev-only@localhost:5432/zhiyu
# 【项目运行环境】本地development；公网受保护联调staging，由部署方切换。
APP_ENV=development
# 【项目内部地址】前端转发到FastAPI的地址；不是声网API地址。
BACKEND_URL=http://127.0.0.1:8000

# Keep cloud switches off until FREE credit is confirmed in BOTH provider consoles.
# 【项目参数】fake为离线模拟，deepseek为真实模型；联调时再切换。
MODEL_PROVIDER=fake
# 【DeepSeek】开放平台→API Keys；填密钥，与声网无关。
DEEPSEEK_API_KEY=
# 【项目参数】DeepSeek模型名称，已设置，无需从声网查找。
DEEPSEEK_MODEL=deepseek-flash
# 【项目开关】是否允许真实云调用；先保持false，赠送额度确认后再开启。
CLOUD_CALLS_ENABLED=false
# 【项目开关】确认各供应商赠送额度后才设true；不是声网控制台字段。
FREE_QUOTA_CONFIRMED=false
# 【项目参数】首文本超时秒数，已设置。
MODEL_FIRST_TEXT_TIMEOUT=2.5
# 【项目参数】整轮模型超时秒数，已设置。
MODEL_TOTAL_TIMEOUT=8
# 【项目限额】每天最多尝试模型调用次数，不代表账户余额。
MAX_DAILY_MODEL_CALLS=30
# 【项目限额】每天最多尝试启动语音次数，不代表赠送分钟数。
MAX_DAILY_VOICE_CALLS=3

# 【项目开关】语音配置、公网地址和服务就绪后再开启；先保持false。
VOICE_ENABLED=false
# 【项目开关】先保持false；语音业务写入还需要可信告知完成证据。
VOICE_WRITES_ENABLED=false
# 【声网服务区域】当前中国区cn；不用复制控制台某个ID。
AGORA_REGION=cn
# Project details: App ID and primary App Certificate (NOT Customer ID).
# 【声网·图3】设置→项目管理→智语外呼项目→APP ID；复制实际值，不要填星号。
AGORA_APP_ID=
# 【声网·图3】同一行“APP主要证书”；点击右侧“管理APP证书”查看主要证书并复制。不是Customer Secret。
AGORA_APP_CERTIFICATE=
# Console Settings > RESTful API > Customer ID and downloaded Secret.
# 【声网·图2】设置→RESTful API→“客户ID/Key”这一列，复制智语外呼备注所在行的ID。不是项目APP ID。
AGORA_CUSTOMER_ID=
# 【声网·图2】同一行“客户密钥/Secret”下点击“下载”，取下载文件中的Secret值；不是文件路径。
AGORA_CUSTOMER_SECRET=
# Use a random >=32 character secret. Do NOT use the DeepSeek API key here.
# 【项目内部密钥】已随机生成；不是声网字段，保持原值，不用填DeepSeek Key。
INTEGRATION_SECRET=
# Fixed public HTTPS origin reaching this FastAPI service; no path suffix.
# 【后续部署】固定公网HTTPS后端地址；不是声网控制台网址，也不是localhost。服务器/域名确定后由接入方填写，当前留空。
INTEGRATION_PUBLIC_URL=
# 【公网域名】例如voice.example.com，不含https://；目前留空，不要填未经备案的新域名。
PUBLIC_HOST=
# 【IP证书方案】仅compose.public-ip.yaml使用；与服务器当前公网IPv4一致。
PUBLIC_IP=
# 【声网语音识别配置】当前中文zh-CN；无需从项目管理复制。引擎服务是否开通仍需确认。
AGORA_ASR_CONFIG='{"language":"zh-CN"}'
# Fill vendor and params according to an enabled provider and its FREE quota.
# TTS may need separate vendor credentials. Never assume Agora credits cover these.
# 【声网语音合成配置】仅TTS_PROVIDER=manual时使用。qwen模式由后端生成URL与会话鉴权，不用手填JSON。
AGORA_TTS_CONFIG='{}'
# 【TTS选择】qwen使用本项目协议转换；manual使用上面的声网原生供应商JSON。
TTS_PROVIDER=qwen
# 【百炼Qwen TTS】需同时填写Key，云调用开关和赠送额度确认后才会调用。
DASHSCOPE_REGION=cn-beijing
# 【百炼业务空间】填写北京地域WorkspaceId；不是API Key。
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_TTS_MODEL=qwen-audio-3.1-tts-flash
# 【百炼音色】先用官方教程系统音色；与模型版本匹配，待真实探针确认账号可用。
DASHSCOPE_TTS_VOICE=longanhuan_v3.1
# 【百炼原生HTTP接口】通常留空，后端按地域和WorkspaceId生成；自填必须与生成地址一致。
DASHSCOPE_TTS_HTTP_URL=
# 【百炼API Key】只在本地.env填写，与DeepSeek Key分开。
DASHSCOPE_API_KEY=
TTS_FIRST_AUDIO_TIMEOUT=5
TTS_TOTAL_TIMEOUT=30
# 【项目限额】每天最多尝试合成次数，不是供应商余额检测。
MAX_DAILY_TTS_CALLS=100
# Required only for APP_ENV=staging; >=16 random characters. Cookie secret >=32.
# 【项目公网联调密码】已随机生成；不是声网密码，本地阶段无需使用。
STAGING_PASSWORD=
# V0.4 opt-in transport; port injection and approved synthetic IDs are also required.
# Keep writes disabled until the independent playback evidence path is accepted.
REALTIME_WEBRTC_ENABLED=false
REALTIME_APPLICATION_IDS=
REALTIME_STUN_URLS=[]
REALTIME_TURN_URLS=
REALTIME_TURN_SECRET=
MAX_DAILY_NATIVE_SESSIONS=2
MAX_DAILY_NATIVE_TURNS=8

# Controlled realtime latency experiment; defaults preserve baseline.
REALTIME_VAD_SILENCE_MS=400
REALTIME_VAD_THRESHOLD=0.5
REALTIME_DIAGNOSTICS_ENABLED=false
REALTIME_TTS_DRAIN_ENABLED=false

# Server whitelist only; generic defaults keep the original 400ms/HTTP baseline.
REALTIME_VAD_MODE=server_vad
REALTIME_SPEECH_BACKEND=qwen_http
REALTIME_ANSWER_FIRST=false
REALTIME_SEGMENTED_REPLIES=false
REALTIME_PREFETCH_SPEECH=false
REALTIME_SHADOW_VOICE_ENABLED=false
