{$PUBLIC_HOST} {
    # No compression: SSE must flush immediately.
    handle /integrations/* {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle /health/* {
        reverse_proxy backend:8000
    }
    handle /api/* {
        reverse_proxy backend:8000 {
            flush_interval -1
        }
    }
    handle {
        reverse_proxy frontend:3000
    }
}
