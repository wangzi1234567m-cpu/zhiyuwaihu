# Replace __PUBLIC_IP__. Assumes project directory /opt/zhiyu and a real IP certificate.
# Add as a new HTTPS site after nginx -T review. Do not replace the existing HTTP site.
server {
    listen 443 ssl;
    server_name __PUBLIC_IP__;
    ssl_certificate /opt/zhiyu/infra/private/letsencrypt/live/zhiyu-ip/fullchain.pem;
    ssl_certificate_key /opt/zhiyu/infra/private/letsencrypt/live/zhiyu-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 128k;
    gzip off;

    location ~ ^/(api|integrations|health)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_next_upstream off;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
